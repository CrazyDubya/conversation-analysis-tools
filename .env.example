# Configuration for Conversation Analysis Tools
# Copy this file to .env and update with your local values

# Database configuration
# Default: conversations.db (in current directory)
# Set to absolute path for production use
DB_PATH=conversations.db

# Pipeline configuration
PIPELINE_CONFIG=config/pipeline_config.yaml

# Output directories (relative or absolute paths)
OUTPUT_DIR=output
VISUALIZATIONS_DIR=visualizations
ADVANCED_VISUALIZATIONS_DIR=advanced_visualizations
CONTENT_ANALYSIS_DIR=content_analysis
LOGS_DIR=logs

# Analysis settings
MAX_RESULTS=100
DEFAULT_PLATFORM=claude

# Logging
LOG_LEVEL=INFO

# Plot settings (optional - defaults in Config class)
# PLOT_STYLE=fivethirtyeight
# FIGURE_SIZE=15,10
# FIGURE_DPI=100
# FONT_SIZE=12
