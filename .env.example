# Configuration for Conversation Analysis Tools
# Copy this file to .env and update with your local values

# Database configuration
# Recommended: Use relative paths or environment-specific locations
DB_PATH=conversations.db

# Pipeline configuration
PIPELINE_CONFIG=config/pipeline_config.yaml

# Output directories
OUTPUT_DIR=output
VISUALIZATIONS_DIR=visualizations
CONTENT_ANALYSIS_DIR=content_analysis
LOGS_DIR=logs

# Analysis settings
MAX_RESULTS=100
DEFAULT_PLATFORM=claude

# Logging
LOG_LEVEL=INFO
